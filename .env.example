# Purpose: Example environment variables for local development.
# Why: Document required secrets without committing real values.
# Info flow: Developer sets env vars -> runtime reads via $env/dynamic/private.

DEFAULT_IMAGE_SIZE=1024x1024
FEATURE_INTEGRATION_TESTS=false
MAX_IMAGES_PER_REQUEST=4
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai
XAI_IMAGE_ENDPOINT_PATH=/v1/images/generations
XAI_IMAGE_MODEL=grok-imagine-image
XAI_TEXT_MODEL=grok-4-1-fast-reasoning

# Wig try-on feature: AI portrait generation via Gemini 2.5 Flash Image.
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Rate limiting for paid AI-calling routes (generate, image-generation, wig-try-on,
# chat-interpretation, meechie-studio-text, tools). In-memory per-process limiter;
# defaults to 20 requests per 60000ms window per client IP if unset.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
