# Purpose: Example environment variables for local development.
# Why: Document required secrets without committing real values.
# Info flow: Developer sets env vars -> runtime reads via $env/dynamic/private.
#
# Model ids are NOT here. They are pinned in src/lib/core/models.js, because a model id is
# not a secret and does not vary per environment. XAI_TEXT_MODEL and XAI_IMAGE_MODEL were
# removed: a stale value left in a deployment silently overrode the code and pinned
# production to a retired model. Any XAI_TEXT_MODEL/XAI_IMAGE_MODEL still set in a
# deployment is now inert and can be deleted safely.

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai
XAI_IMAGE_ENDPOINT_PATH=/v1/images/generations
FEATURE_INTEGRATION_TESTS=false
MAX_IMAGES_PER_REQUEST=4
DEFAULT_IMAGE_SIZE=1024x1024

# Wig try-on feature: AI portrait generation via Gemini 2.5 Flash Image.
# Get your key at https://aistudio.google.com/app/apikey
# A 429 quota response requires available Gemini quota/billing; changing app code cannot restore it.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
