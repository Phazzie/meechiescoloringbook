# Purpose: Example environment variables for local development.
# Why: Document required secrets without committing real values.
# Info flow: Developer sets env vars -> runtime reads via $env/dynamic/private.
#
# Model ids are NOT here. They are pinned in src/lib/core/models.js, because a model id is
# not a secret and does not vary per environment. XAI_TEXT_MODEL and XAI_IMAGE_MODEL were
# removed: a stale value left in a deployment silently overrode the code and pinned
# production to a retired model. Any XAI_TEXT_MODEL/XAI_IMAGE_MODEL still set in a
# deployment is now inert and can be deleted safely.

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai
XAI_IMAGE_ENDPOINT_PATH=/v1/images/generations
FEATURE_INTEGRATION_TESTS=false
DEFAULT_IMAGE_SIZE=1024x1024

# Durable server-side rate limits. Client addresses are normalized and HMAC-SHA256 hashed;
# the resulting identifiers are pseudonymous, not anonymous. Use a dedicated random secret.
#
# Set ALL THREE or NONE:
#   - all three set and valid  -> durable shared limits across every serverless instance
#   - all three absent         -> degraded mode: still rate limited, but the window is
#                                per-instance, so N instances allow at most N x the budget
#   - partially set or invalid -> every AI route returns 503, deliberately. A half-configured
#                                limiter is a misconfiguration, not a reason to silently degrade.
# There is no switch that turns rate limiting off. Budgets are 20/min shared across the text
# routes and 8/min shared across the image routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_IDENTITY_SECRET=
RATE_LIMIT_OPERATION_TIMEOUT_MS=1500

# LEGACY / UNUSED. The wig try-on feature no longer calls Gemini.
# It was migrated to xAI's multi-image edit endpoint (/v1/images/edits) because the Gemini
# free tier was exhausted and no app-code change could restore that quota. The route now uses
# XAI_API_KEY and XAI_BASE_URL above; these two variables are read only into AppConfig and are
# not used by any runtime path. Leaving them set is harmless; they can be deleted.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
