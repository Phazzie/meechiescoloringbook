# Purpose: Ignore local secrets and generated files.
# Why: Prevent committing sensitive or machine-specific data.
# Info flow: Git reads ignore patterns -> local files remain untracked.

node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build
/dist

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
.env.local
!.env.example
!.env.test

# Local npm cache
.npm-cache

# Machine-local agent permissions
/.claude/settings.local.json

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Test output
test-results
playwright-report
